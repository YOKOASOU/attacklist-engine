# X (Twitter) API認証情報
# https://developer.twitter.com/en/portal/dashboard で取得
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here
X_BEARER_TOKEN=your_bearer_token_here

# Anthropic Claude API
# https://console.anthropic.com で取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 送信設定
DM_INTERVAL_SECONDS=60          # DM送信間隔（秒）
DM_DAILY_LIMIT=50               # 1日の送信上限
DM_DRY_RUN=true                 # true=テスト実行（実際には送信しない）

# ログ設定
LOG_LEVEL=INFO
LOG_FILE=data/logs/dm_system.log
